{
    "plugins": {
        "heading-style": {
            "enabled": true,
            "style": "atx"
        },
        "commands-show-output": {
            "enabled": false
        },
        "no-missing-space-atx": {
            "enabled": true
        },
        "line-length": {
            "enabled": false
        },
        "first-line-heading": {
            "enabled": false
        },
        "blanks-around-headings": {
            "enabled": true
        },
        "blanks-around-lists": {
            "enabled": true
        }
    },
    "extensions": {
        "front-matter": {
            "enabled": true
        }
    }
}
